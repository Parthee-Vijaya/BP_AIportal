# Valgfri lokal placering. Render bruger /var/data/database.sqlite.
# DB_PATH=./backend/src/db/database.sqlite

# Kommaseparerede origins, hvis API'et kaldes direkte fra en anden origin.
# CORS_ORIGIN=http://localhost:5173

# AI-portal SSO (bag portalen sættes disse af docker-compose; tomme = auth slået fra).
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# SHIELD_SESSION_COOKIE=shield-session
# BARNEPIGE_ENTRA_GROUP=

# De fire AD/Entra-grupper (object-id'er) der styrer appens roller. Tomme =
# rollerne vælges på demo-rolleskærmen i stedet.
# BARNEPIGE_GROUP_ACCESS=
# BARNEPIGE_GROUP_BRUGER=
# BARNEPIGE_GROUP_GODKENDER=
# BARNEPIGE_GROUP_ADMINISTRATOR=
